APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
POSTGRES_USER=studee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studee
DATABASE_URL=postgresql://studee:change-me@db:5432/studee
TZ=Europe/Bucharest
APP_PORT=3000
MAX_UPLOAD_MB=50
GOOGLE_GEMINI_API_KEY=        # optional; leave empty to disable AI features
GEMINI_MODEL=gemini-3.5-flash # optional; this is the default
BRAVE_SEARCH_API_KEY=         # optional; roadmaps find real resources with Brave Search
COOKIE_SECURE=false           # set true when serving over HTTPS
TRUST_PROXY=false             # set true only behind a reverse proxy that sets X-Forwarded-For
